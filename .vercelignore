# Deploy hygiene — exclude local dev/diagnostic artifacts (not part of the app build/runtime).
# Keeps the Vercel source upload small and reliable.

# Screenshot + diagnostic captures (Playwright/Chrome verification runs)
screenshots/

# Inspiration / moodboard images
INSPO/

# Markdown docs, specs, plans, design notes — never needed at build or runtime
docs/

