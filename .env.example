# ==========================================
# ClearPath Coach OS — Environment Variables
# Copy this file to .env.local and fill in
# ==========================================

# SUPABASE (required)
# Get from: supabase.com/dashboard/project/
#   [ref]/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# STRIPE (required for billing)
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_SCALE_ID=

# GOOGLE DRIVE (required for video import)
# Get from: console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the OAuth client redirect URI in Google Cloud (see integrations/google-drive/callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# If set, overrides built-in redirect (same as GOOGLE_REDIRECT_URI for most installs)
# GOOGLE_DRIVE_REDIRECT_URI=

# Signed stream tokens — HMAC secret for /api/videos/[id]/stream?token= (Range playback).
# Generate a long random string; set in Vercel production. Optional locally; recommended in prod.
VIDEO_STREAM_TOKEN_SECRET=

# N8N / legacy pipelines (optional — not required for Drive direct streaming)
N8N_WEBHOOK_URL=
N8N_CALLBACK_SECRET=

# CloudConvert (video import / webhooks; optional HMAC for account webhooks)
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_WEBHOOK_SECRET=

# UPSTASH REDIS (required for rate limiting)
# Get from: console.upstash.com
# Create a Redis database, copy REST URL and token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# APP URL (required)
# Local: http://localhost:3000
# Production: https://app.clearpath.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RESEND EMAIL (required for invite emails)
# Get from: resend.com
RESEND_API_KEY=

# DEV WIPE (pnpm run wipe:dev) — deletes ALL workspaces + ALL Auth users. Never production.
# CLEARPATH_DEV_WIPE_CONFIRM=DELETE_ALL_APP_DATA

# SUPER ADMIN — only this email can access /admin (hardcoded server check; not grantable via UI)
ADMIN_EMAIL=jpotesta15@outlook.com

# Optional: pnpm run setup:admin will create the Auth user if missing (dev only; remove after first run)
# ADMIN_BOOTSTRAP_PASSWORD=

# After signup (or bootstrap), run: pnpm run setup:admin — sets profiles.is_super_admin (RLS); access still requires ADMIN_EMAIL match.

# TEST CLIENT (pnpm run seed:test-client — after create:demo)
# CLEARPATH_TEST_COACH_EMAIL=coach@example.com
# CLEARPATH_TEST_CLIENT_EMAIL=client@example.com
# CLEARPATH_TEST_CLIENT_PASSWORD=ClientDemo123!

# LOCAL DEVELOPMENT
# The login page shows a “Clear session” control when NODE_ENV=development.
# Use it to sign out instantly and test coach / client / admin flows without a private window.
# No env flag required.

# TESTING (optional)
# Set to 1 to enable strict rate limiting
# during test runs
# CLEARPATH_TEST_RATE_LIMIT=1
