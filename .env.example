# ==========================================
# ClearPath Coach OS — Environment Variables
# Copy this file to .env.local and fill in
# ==========================================

# SUPABASE (required)
# Get from: supabase.com/dashboard/project/[ref]/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override default bucket for coach video uploads (lib/drive-import/supabase-video-storage.ts)
# SUPABASE_VIDEO_BUCKET=

# STRIPE (required for SaaS billing / checkout)
# Get from: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_SCALE_ID=

# STRIPE CONNECT (for client payments)
# Get from: dashboard.stripe.com/connect
STRIPE_CONNECT_DEFAULT_COUNTRY=US

# GOOGLE DRIVE (required for video import)
# Get from: console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# GOOGLE_DRIVE_REDIRECT_URI=

# Signed stream tokens — HMAC for /api/videos/[id]/stream?token= (lib/stream-token.ts)
VIDEO_STREAM_TOKEN_SECRET=

# N8N WEBHOOKS (optional — for automation; Drive direct streaming can work without n8n)
# Shared secret: POST /api/videos/from-n8n, resolve-folder, processing-complete (X-Clearpath-Secret)
N8N_CALLBACK_SECRET=
# Session reminders (app/api/sessions/[id]/send-reminder)
N8N_SESSION_REMINDER_ON_DEMAND_URL=
# Session booked notification (admin/system health, optional workflows)
N8N_SESSION_BOOKED_WEBHOOK_URL=
# Video processing webhook secret (admin/system health)
N8N_VIDEO_WEBHOOK_SECRET=

# CloudConvert (optional — video import / webhooks)
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_WEBHOOK_SECRET=

# CLOUDINARY (optional — for image CDN)
# Only needed if you use Cloudinary (lib/drive-import/cloudinary.ts)
# Leave empty to use Supabase Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# UPSTASH REDIS — required on Vercel production for rate limiting
# Missing → 429 on signup, login, and most API routes (lib/rate-limit.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# APP URL (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# EMAIL (required for notifications)
# Get from: resend.com → API Keys
RESEND_API_KEY=
# The from address for all emails (lib/notifications/messages.ts, admin test-email)
# Must be verified in Resend dashboard
EMAIL_FROM_DEFAULT=noreply@clearpath.com

# Optional: multi-tenant client label exposed to browser (lib/config.ts)
# NEXT_PUBLIC_CLIENT_ID=default

# DEV WIPE (pnpm run wipe:dev) — never production
# CLEARPATH_DEV_WIPE_CONFIRM=DELETE_ALL_APP_DATA

# SUPER ADMIN — only this email can access /admin (lib/admin-email.ts)
ADMIN_EMAIL=jpotesta15@outlook.com
# ADMIN_BOOTSTRAP_PASSWORD=
# CLEARPATH_ADMIN_PASSWORD= (scripts/setup-admin.ts)

# VERCEL (set automatically by Vercel)
# Do not set manually
# VERCEL_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=
# VERCEL_PROTECTION_BYPASS_SECRET=

# ANALYZE (optional — next bundle analyzer, next.config.ts)
# ANALYZE=true

# LOCAL DEVELOPMENT — login page “Clear session” when NODE_ENV=development

# TESTING (only for running tests — prefer .env.test / CI, not .env.local)
# TEST_BASE_URL=http://localhost:3000
# CLEARPATH_TEST_COACH_EMAIL=
# CLEARPATH_TEST_CLIENT_EMAIL=
# CLEARPATH_TEST_CLIENT_PASSWORD=
# CLEARPATH_TEST_RATE_LIMIT=1
