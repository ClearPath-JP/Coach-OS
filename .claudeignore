# Dependencies — never read these
node_modules/
.pnp/
.pnp.js

# Next.js build output
.next/
out/
build/

# Supabase generated
supabase/.temp/
supabase/functions/.deno/

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Package manager locks (read package.json instead)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment files — never read
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage output
coverage/
.nyc_output/

# Temporary / archived folders
_tmp-portal.html
_V1-audit/
_missing/
_multi-tenet/

# Large generated files
*.min.js
*.min.css
